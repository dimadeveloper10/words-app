# App
NODE_ENV=development
PORT=3000

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# JWT (access token)
JWT_SECRET=
JWT_EXPIRES_IN=

# CORS: comma-separated allowed origins (admin panel + web app dev servers)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Redis cache
REDIS_URL=redis://localhost:6379

# Rate limiting: window in ms and max requests per window per client IP
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# First superadmin (used by `npm run seed`)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
