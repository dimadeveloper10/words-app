# App
NODE_ENV=development
PORT=3000

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=words_app

# JWT (access token)
JWT_SECRET=change_me_to_a_long_random_secret_min_16_chars
JWT_EXPIRES_IN=1d

# CORS: comma-separated allowed origins (admin panel dev server)
CORS_ORIGIN=http://localhost:5173

# First superadmin (used by `npm run seed`)
SUPERADMIN_EMAIL=admin@words.app
SUPERADMIN_PASSWORD=changeme123
